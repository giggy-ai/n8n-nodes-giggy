{
  "name": "n8n-nodes-giggy",
  "version": "0.1.0",
  "description": "Official Giggy text-to-speech and voice catalog nodes for n8n",
  "license": "MIT",
  "homepage": "https://github.com/giggy-ai/n8n-nodes-giggy",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "Henry Chim",
    "email": "henry@giggy.ai"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giggy-ai/n8n-nodes-giggy.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "node --test test/*.test.cjs"
  },
  "files": [
    "dist",
    "examples",
    "!dist/**/*.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/GiggyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Giggy/Giggy.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.52.2",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
